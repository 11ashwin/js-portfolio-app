# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
PORT=3001
NODE_ENV=development
# Origin(s) allowed to call this API — your frontend's local URL.
CORS_ORIGIN=http://localhost:5500

# --- PostgreSQL ---
# If you're using the included docker-compose.yml, these defaults already match it.
PGHOST=localhost
PGPORT=5432
PGDATABASE=portfolio
PGUSER=portfolio_app
PGPASSWORD=change_me_locally

# --- Auth ---
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Rate limiting (recruiter inquiry form) ---
INQUIRY_RATE_LIMIT_WINDOW_MS=3600000
INQUIRY_RATE_LIMIT_MAX=5
